{
  "expo": {
    "name": "TornPulse",
    "slug": "tornpulse",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.comfortableai.torncopilot",
      "versionCode": 24,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "torn-alerts"
        }
      ],
      "expo-secure-store"
    ]
  }
}
