{
  "name": "tornpulse",
  "version": "1.0.1",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "apk:debug": "npm run prebuild:android && cd android && ./gradlew assembleDebug",
    "bundle:release": "npm run prebuild:android && cd android && ./gradlew bundleRelease",
    "selftest": "node scripts/self-test.cjs"
  },
  "dependencies": {
    "expo": "~57.0.0",
    "expo-notifications": "~57.0.13",
    "expo-secure-store": "*",
    "expo-status-bar": "*",
    "react": "19.2.3",
    "react-native": "0.86.0"
  }
}
